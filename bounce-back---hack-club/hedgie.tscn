script/source = "extends Area2D

func _on_pickup_area_area_entered(area):
	print(\"hehehahhaha\")
	if area.is_in_group(\"Ram\"):
		area.queue_free()	
	if area.is_in_group(\"Heal\"):
		Playerstats.health += 5
		area.queue_free()
		
	
"

